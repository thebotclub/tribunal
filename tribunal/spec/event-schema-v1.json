{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tribunal.dev/spec/event-schema-v1.json",
  "title": "Tribunal Unified Agent Event",
  "description": "The canonical event format every Tribunal adapter normalises to. Versioned: breaking changes require a new file (event-schema-v2.json).",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "ts",
    "agent",
    "agent_version",
    "session_id",
    "user_id",
    "event_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1",
      "description": "Schema major version. Bumped only on breaking changes."
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique event identifier. UUIDv4 recommended; UUIDv7 preferred when available for time-orderable IDs."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with timezone. Generated by the adapter at event capture time."
    },
    "agent": {
      "type": "string",
      "enum": ["claude-code", "cursor", "copilot-cli", "codex-cli", "other"],
      "description": "The coding agent that produced the source event. 'other' is for community-contributed adapters; the adapter MUST set agent_name in that case."
    },
    "agent_name": {
      "type": "string",
      "description": "Required only when agent='other'. Human-readable identifier (e.g. 'aider', 'continue', 'sweep')."
    },
    "agent_version": {
      "type": "string",
      "description": "Version string reported by the agent. Best-effort; may be 'unknown'."
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Agent's own session identifier. Stable across one user/agent run."
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "description": "Hashed local OS user or SSO subject. Tribunal never sends the plaintext username unless --with-content is set."
    },
    "machine_id": {
      "type": "string",
      "description": "Hashed machine identifier. Stable per-host. Optional for OSS local use, required for cloud ingest."
    },
    "repo_path": {
      "type": "string",
      "description": "Absolute path to the repo root at event time. May be redacted to '<redacted>' in cloud mode."
    },
    "repo_remote": {
      "type": "string",
      "description": "Git remote URL if available (e.g. git@github.com:org/repo.git). Empty string if not in a repo."
    },
    "branch": {
      "type": "string",
      "description": "Current git branch if available."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session.start",
        "session.end",
        "prompt.submitted",
        "tool.proposed",
        "tool.approved",
        "tool.denied",
        "tool.executed",
        "tool.failed",
        "mcp.call.before",
        "mcp.call.after",
        "file.read",
        "file.write",
        "file.delete",
        "bash.executed",
        "subagent.start",
        "subagent.stop",
        "policy.block",
        "policy.ask",
        "policy.allow",
        "injection.suspected",
        "cost.recorded",
        "error.gate"
      ],
      "description": "The semantic event type. See $defs.eventTypes for per-type payload shapes."
    },
    "payload": {
      "type": "object",
      "description": "Event-type-specific fields. See $defs.payloads.* for shape per event_type. Adapters MAY include extra fields under payload but MUST include the required ones for the event_type."
    },
    "cost": {
      "type": "object",
      "description": "Token and dollar accounting. Present on cost.recorded; optional on tool.executed when the agent reports cost inline.",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "model": { "type": "string" },
        "usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "policy_decision": {
      "type": ["string", "null"],
      "enum": ["allow", "ask", "deny", "warn", null],
      "description": "Set by the Tribunal policy engine when the event was evaluated. Null when no policy was applied."
    },
    "policy_rule": {
      "type": "string",
      "description": "Name of the policy rule that produced the decision (e.g. 'secrets-readonly:deny-dotenv-write')."
    },
    "policy_message": {
      "type": "string",
      "description": "Human-readable message returned to the agent (e.g. shown in Claude Code stderr)."
    },
    "trace_id": {
      "type": "string",
      "description": "OpenTelemetry trace ID propagated from upstream if available. Hex string."
    },
    "span_id": {
      "type": "string",
      "description": "OpenTelemetry span ID. Hex string."
    },
    "tags": {
      "type": "object",
      "description": "Free-form label set. Used for org-defined attributes (team, env, ticket).",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "agent": { "const": "other" } }, "required": ["agent"] },
      "then": { "required": ["agent_name"] }
    }
  ],

  "$defs": {
    "payloads": {
      "session.start": {
        "type": "object",
        "properties": {
          "permission_mode": { "type": "string", "enum": ["default", "yolo", "user_approved", "plan"] },
          "model": { "type": "string" },
          "cwd": { "type": "string" }
        }
      },
      "session.end": {
        "type": "object",
        "properties": {
          "duration_ms": { "type": "integer", "minimum": 0 },
          "tool_calls": { "type": "integer", "minimum": 0 },
          "exit_reason": { "type": "string", "enum": ["clean", "interrupted", "error"] }
        }
      },
      "prompt.submitted": {
        "type": "object",
        "required": ["prompt_hash"],
        "properties": {
          "prompt_hash": {
            "type": "string",
            "description": "SHA-256 of the prompt text. Always present.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "prompt_chars": { "type": "integer", "minimum": 0 },
          "prompt": { "type": "string", "description": "Plaintext prompt. Present ONLY when --with-content is set." }
        }
      },
      "tool.proposed": {
        "type": "object",
        "required": ["tool_name"],
        "properties": {
          "tool_name": { "type": "string", "description": "e.g. 'Bash', 'FileEdit', 'Read', or MCP tool name." },
          "tool_use_id": { "type": "string" },
          "tool_input": { "type": "object", "description": "Arguments. PII-sensitive fields are hashed unless --with-content is set." },
          "target_paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Filesystem paths the tool will touch, if statically determinable."
          }
        }
      },
      "tool.approved": {
        "type": "object",
        "properties": {
          "tool_name": { "type": "string" },
          "tool_use_id": { "type": "string" },
          "approver": { "type": "string", "enum": ["user", "policy", "auto"] }
        }
      },
      "tool.denied": {
        "type": "object",
        "properties": {
          "tool_name": { "type": "string" },
          "tool_use_id": { "type": "string" },
          "denier": { "type": "string", "enum": ["user", "policy"] },
          "reason": { "type": "string" }
        }
      },
      "tool.executed": {
        "type": "object",
        "required": ["tool_name"],
        "properties": {
          "tool_name": { "type": "string" },
          "tool_use_id": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "exit_code": { "type": "integer" },
          "stdout_bytes": { "type": "integer", "minimum": 0 },
          "stderr_bytes": { "type": "integer", "minimum": 0 },
          "result_summary": { "type": "string", "description": "Short adapter-provided summary." }
        }
      },
      "tool.failed": {
        "type": "object",
        "required": ["tool_name", "error"],
        "properties": {
          "tool_name": { "type": "string" },
          "tool_use_id": { "type": "string" },
          "error": { "type": "string" },
          "error_class": { "type": "string" }
        }
      },
      "mcp.call.before": {
        "type": "object",
        "required": ["server", "method"],
        "properties": {
          "server": { "type": "string" },
          "method": { "type": "string" },
          "params_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "mcp.call.after": {
        "type": "object",
        "required": ["server", "method"],
        "properties": {
          "server": { "type": "string" },
          "method": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "success": { "type": "boolean" }
        }
      },
      "file.read": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      },
      "file.write": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "is_create": { "type": "boolean" }
        }
      },
      "file.delete": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" }
        }
      },
      "bash.executed": {
        "type": "object",
        "required": ["command_hash"],
        "properties": {
          "command_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "command": { "type": "string", "description": "Present only when --with-content is set." },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      },
      "subagent.start": {
        "type": "object",
        "properties": {
          "subagent_id": { "type": "string" },
          "parent_session_id": { "type": "string" },
          "purpose": { "type": "string" }
        }
      },
      "subagent.stop": {
        "type": "object",
        "properties": {
          "subagent_id": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "exit_reason": { "type": "string" }
        }
      },
      "policy.block": {
        "type": "object",
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string" },
          "matched_event_id": { "type": "string", "format": "uuid" },
          "message": { "type": "string" }
        }
      },
      "policy.ask": {
        "type": "object",
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string" },
          "matched_event_id": { "type": "string", "format": "uuid" },
          "message": { "type": "string" }
        }
      },
      "policy.allow": {
        "type": "object",
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string" },
          "matched_event_id": { "type": "string", "format": "uuid" }
        }
      },
      "injection.suspected": {
        "type": "object",
        "required": ["source", "signals"],
        "properties": {
          "source": { "type": "string", "enum": ["prompt", "tool_output", "file_content", "mcp_response", "url_fetch"] },
          "signals": {
            "type": "array",
            "items": { "type": "string", "enum": ["hidden_unicode", "base64_blob", "instruction_injection", "url_disguise", "policy_keyword"] },
            "minItems": 1
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sample_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "cost.recorded": {
        "type": "object",
        "description": "Pure cost accounting event. Cost details go in the top-level 'cost' field, not in payload."
      },
      "error.gate": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "fail_mode": { "type": "string", "enum": ["open", "closed"] },
          "exit_code": { "type": "integer" }
        }
      }
    },

    "examples": {
      "tool.proposed.bash": {
        "schema_version": "1",
        "event_id": "0193c54a-3a8c-7c80-9a2a-c5d3f0a4b1e9",
        "ts": "2026-05-13T02:38:00.123Z",
        "agent": "claude-code",
        "agent_version": "1.0.93",
        "session_id": "sess_a1b2c3",
        "user_id": "sha256:9f1b...e2",
        "machine_id": "sha256:7c8a...11",
        "repo_path": "/Users/hk/code/tribunal.dev",
        "repo_remote": "git@github.com:thebotclub/tribunal.dev.git",
        "branch": "v3-pivot/week-1",
        "event_type": "tool.proposed",
        "payload": {
          "tool_name": "Bash",
          "tool_use_id": "toolu_01ABCD",
          "tool_input": { "command": "rm -rf node_modules" },
          "target_paths": ["/Users/hk/code/tribunal.dev/node_modules"]
        },
        "policy_decision": null
      },
      "policy.block.example": {
        "schema_version": "1",
        "event_id": "0193c54a-3a8c-7c80-9a2a-c5d3f0a4b1ea",
        "ts": "2026-05-13T02:38:00.456Z",
        "agent": "cursor",
        "agent_version": "0.45.2",
        "session_id": "cursor_sess_42",
        "user_id": "sha256:9f1b...e2",
        "event_type": "policy.block",
        "payload": {
          "rule": "secrets-readonly:deny-dotenv-write",
          "matched_event_id": "0193c54a-3a8c-7c80-9a2a-c5d3f0a4b1e9",
          "message": "Tribunal blocked a write to .env (rule: secrets-readonly)."
        },
        "policy_decision": "deny",
        "policy_rule": "secrets-readonly:deny-dotenv-write"
      },
      "cost.recorded.example": {
        "schema_version": "1",
        "event_id": "0193c54a-3a8c-7c80-9a2a-c5d3f0a4b1eb",
        "ts": "2026-05-13T02:38:00.789Z",
        "agent": "claude-code",
        "agent_version": "1.0.93",
        "session_id": "sess_a1b2c3",
        "user_id": "sha256:9f1b...e2",
        "event_type": "cost.recorded",
        "payload": {},
        "cost": {
          "input_tokens": 12834,
          "output_tokens": 2103,
          "cache_read_tokens": 50000,
          "model": "claude-opus-4-6",
          "usd": 0.1742
        }
      },
      "injection.suspected.example": {
        "schema_version": "1",
        "event_id": "0193c54a-3a8c-7c80-9a2a-c5d3f0a4b1ec",
        "ts": "2026-05-13T02:38:01.001Z",
        "agent": "claude-code",
        "agent_version": "1.0.93",
        "session_id": "sess_a1b2c3",
        "user_id": "sha256:9f1b...e2",
        "event_type": "injection.suspected",
        "payload": {
          "source": "tool_output",
          "signals": ["hidden_unicode", "instruction_injection"],
          "confidence": 0.82,
          "sample_hash": "1a2b3c4d5e6f70819a2b3c4d5e6f70819a2b3c4d5e6f70819a2b3c4d5e6f7081"
        }
      }
    }
  }
}
